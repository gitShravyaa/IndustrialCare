# Copy this file to ".env" (same folder) and paste the values from
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# NEVER commit your real .env file. NEVER put service-account keys in here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public URL of the Express API (local example: http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# Optional: set to "true" to run the app against the local Firebase Emulator Suite
# (no real Firebase project needed - useful for trying everything out first).
VITE_USE_FIREBASE_EMULATORS=false

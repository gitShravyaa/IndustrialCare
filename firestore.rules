rules_version = '2';

// ============================================================================
// IndustrialCare - Firestore Security Rules
//
// Model: the browser can READ data it is entitled to (real-time listeners) but
// can NOT WRITE business data. Every write goes through a Cloud Function that
// re-checks the caller's role (custom claim + users/{uid} record), validates
// input, and applies changes inside transactions.
// The only client write allowed: a user marking their OWN notification as read.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isRole(r) { return signedIn() && role() == r; }
    function isStaff() {
      return signedIn() && role() in ['worker', 'maintenance', 'warehouse'];
    }

    // A user can read only their own profile. Roles are never writable from clients.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // All employees can see all registered machines.
    match /machines/{machineId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Workers: only complaints they submitted. Maintenance: all complaints.
    match /complaints/{complaintId} {
      allow read: if isRole('maintenance')
                  || (isRole('worker') && resource.data.reportedByUid == request.auth.uid);
      allow write: if false;
    }

    match /maintenanceRecords/{recordId} {
      allow read: if isRole('maintenance');
      allow write: if false;
    }

    // Inventory is readable by staff (needed for the "request material" picker).
    match /sparePartsInventory/{itemId} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /otherItemsInventory/{itemId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /sparePartRequests/{requestId} {
      allow read: if isRole('maintenance') || isRole('warehouse')
                  || (isRole('worker') && resource.data.requestedByUid == request.auth.uid);
      allow write: if false;
    }

    match /inventoryTransactions/{txId} {
      allow read: if isRole('warehouse');
      allow write: if false;
    }

    match /stockAlerts/{alertId} {
      allow read: if isRole('warehouse');
      allow write: if false;
    }

    // Notifications are created by Cloud Functions. Recipient may only flip "read".
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.recipientUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                    && request.resource.data.read is bool;
      allow create, delete: if false;
    }

    // Internal collections (ID counters, employee-ID reservations): no client access at all.
    match /counters/{doc} { allow read, write: if false; }
    match /badgeIds/{doc} { allow read, write: if false; }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
